function sendColEmail_(p,duration,pdf,ref){
 const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const html=`<div style="margin:0;background:#f5f5f7;padding:28px 12px;font-family:Arial,sans-serif;color:#1d1d1f"><div style="max-width:680px;margin:auto;background:#fff;border-radius:18px;overflow:hidden;border:1px solid #e5e7eb"><div style="background:#0e1b2a;padding:26px 30px;color:#fff"><div style="font-size:12px;letter-spacing:1.5px;color:#c9b37e;font-weight:700">INSTITUTE OF POSTGRADUATE STUDIES</div><h1 style="font-size:25px;margin:9px 0 0">Your Conditional Offer Letter is ready</h1></div><div style="padding:30px"><p>Dear <strong>${esc(p.fullName)}</strong>,</p><p>Congratulations and thank you for choosing Innovative University College. Your Conditional Offer Letter (COL) has been issued and is attached to this email.</p><div style="background:#f7f8fa;border-radius:12px;padding:18px;margin:22px 0"><b>${esc(p.programme)}</b><br><span style="color:#666">Duration: ${esc(duration)} &nbsp;•&nbsp; Intake: ${esc(p.intake)} &nbsp;•&nbsp; Study Mode: Full Time</span></div><p style="margin-bottom:10px"><strong>Next step: Complete your official Admission Form</strong></p><a href="${REGISTRATION_LINK}" style="display:inline-block;background:#0071e3;color:white;text-decoration:none;padding:14px 22px;border-radius:10px;font-weight:700">Complete Admission Form →</a><div style="margin:28px 0;border-top:1px solid #eee;padding-top:22px"><div style="font-weight:700;margin-bottom:12px">Your admission journey</div><div style="line-height:2;color:#555">1. Complete Admission Form<br>2. Admission Screening<br>3. Admission Endorsement<br>4. Orientation<br>5. Start Your Class</div></div><p style="font-size:13px;color:#666">Depending on the admission screening outcome, additional assessment or academic requirements may apply before final admission.</p><div style="background:#faf8f2;border-radius:12px;padding:16px;margin-top:22px"><strong>Need assistance?</strong><br>En. Saiful Nizam<br>+60 17-870 8296</div><p style="margin-top:28px">Best regards,<br><strong>Registry Office</strong><br>Innovative University College</p><p style="font-size:11px;color:#999">Registration reference: ${esc(ref)} · This is a computer-generated email. No signature is required.</p></div></div></div>`;
 const text=`Dear ${p.fullName},\n\nCongratulations. Your Conditional Offer Letter for ${p.programme} is attached.\n\nNext step: Complete the official Admission Form: ${REGISTRATION_LINK}\n\nAdmission journey: Complete Admission Form > Admission Screening > Admission Endorsement > Orientation > Start Your Class.\n\nFor assistance: En. Saiful Nizam, +60 17-870 8296.\n\nRegistry Office\nInnovative University College`;
 MailApp.sendEmail({to:p.email,cc:CC_EMAILS,subject:`Conditional Offer Letter – ${p.programme}`,body:text,htmlBody:html,attachments:[pdf.getBlob()]});
}
